{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "k9-airdrop-toolkit",
  "homepage": "https://github.com/K9-Finance-DAO/airdrop-token-claim",
  "items": [
    {
      "name": "token-claim",
      "type": "registry:block",
      "title": "TokenClaim Widget",
      "description": "Generic single-token Merkle airdrop claim widget for TokenClaim-style contracts.",
      "dependencies": [
        "wagmi@^3.6.16",
        "viem@^2.52.0",
        "lucide-react@^1.17.0"
      ],
      "files": [
        {
          "path": "components/token-claim.tsx",
          "type": "registry:component"
        },
        {
          "path": "lib/token-claim.ts",
          "type": "registry:lib"
        }
      ],
      "cssVars": {
        "theme": {},
        "light": {
          "airdrop-claim-accent": "oklch(0.55 0.22 255)",
          "airdrop-claim-radius": "0.75rem"
        },
        "dark": {
          "airdrop-claim-accent": "oklch(0.62 0.22 255)",
          "airdrop-claim-radius": "0.75rem"
        }
      }
    },
    {
      "name": "terms-quiz",
      "type": "registry:block",
      "title": "Terms Quiz",
      "description": "Reusable terms comprehension quiz with fake defaults and pluggable attestation callback.",
      "dependencies": [
        "lucide-react@^1.17.0",
        "wagmi@^3.6.16",
        "viem@^2.52.0"
      ],
      "files": [
        {
          "path": "components/terms-quiz.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "eas-terms-kit",
      "type": "registry:item",
      "title": "EAS Terms Kit",
      "description": "EAS terms attestation helpers, terms hashing/IPFS scripts, schema registration script, and runbook templates.",
      "dependencies": [
        "wagmi@^3.6.16",
        "viem@^2.52.0"
      ],
      "files": [
        {
          "path": "lib/eas-terms.ts",
          "type": "registry:lib"
        },
        {
          "path": "scripts/prepare-eas-terms.mjs",
          "type": "registry:file",
          "target": "scripts/prepare-eas-terms.mjs"
        },
        {
          "path": "scripts/register-eas-terms-schema.mjs",
          "type": "registry:file",
          "target": "scripts/register-eas-terms-schema.mjs"
        },
        {
          "path": "templates/terms-v1.md",
          "type": "registry:file",
          "target": "terms/terms-v1.md"
        },
        {
          "path": "docs/eas-terms-runbook.md",
          "type": "registry:file",
          "target": "docs/eas-terms-runbook.md"
        }
      ]
    }
  ]
}
